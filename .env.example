# =====================================================
# 环境变量模板：cp .env.example .env 后按需填写
#
# 开发（docker compose up -d）：全部留空即用默认值，开箱可跑。
# 生产（docker compose -f docker-compose.prod.yml up -d）：标注「生产必填」的项缺一不可，
#   缺失或仍为开发默认值时，compose 的 ${VAR:?} 与 Java 的 StartupConfigValidator 都会拒绝启动。
# 切勿把填好的 .env 提交到仓库。
# =====================================================

# ---------- 数据库 ----------
POSTGRES_USER=interview
# 生产必填：强口令，禁止 interview123
POSTGRES_PASSWORD=interview123
POSTGRES_DB=interview_agent

# ---------- 令牌与内部鉴权 ----------
# 生产必填：≥32 字节随机串（如 openssl rand -base64 48）
# 访问令牌有效期 30 分钟；refresh token 7 天（Redis 可吊销）
APP_JWT_SECRET=interview-agent-local-dev-secret-key-32bytes
# 生产必填：Java → python-ai 的内部调用密钥，两边必须一致；AI 层拒绝未携带 X-Internal-Token 的请求
APP_INTERNAL_TOKEN=interview-agent-local-dev-internal-token

# ---------- CORS ----------
# 生产必填：站点域名，逗号分隔（如 https://interview.example.com）
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- 大模型 ----------
# 生产必填：AI 层缺少可用 key 将无法出题/评测
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- Embedding / ASR（通义千问 DashScope，可复用同一 key） ----------
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
ASR_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=
ASR_MODEL=paraformer-8k-v1
DASHSCOPE_API_KEY=

# ---------- 能力开关 ----------
RERANK_ENABLED=true
MCP_ENABLED=false

# ---------- P1 性能与成本（可选，留空即用默认值） ----------
# 重排实现：auto=本地模型优先、不可用时回退 DashScope；local=仅本地；api=仅 DashScope；none=关闭
RERANK_PROVIDER=auto
# DashScope 重排 key，留空则复用 EMBEDDING_API_KEY
RERANK_API_KEY=
RERANK_API_MODEL=gte-rerank-v2
# 评测降本：主评与清单判定并发；边界双评委抽样比例（0=关闭 1=全量）；极端分二次校验
EVAL_POOL_SIZE=16
EVAL_DOUBLE_JUDGE_RATIO=0.2
EVAL_EXTREME_RECHECK=true
# RAG 检索结果 Redis 缓存（秒）与开关
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=600

# ---------- 上下文压缩（Java 侧） ----------
# 最近 N 轮问答保留全文，更早轮次只传评分摘要
APP_FULL_HISTORY_TURNS=5
